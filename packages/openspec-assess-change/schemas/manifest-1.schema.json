{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openspec-assess.local/schemas/manifest-1.schema.json",
  "title": "Assessment run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "assessmentId",
    "change",
    "stage",
    "version",
    "versionDigest",
    "asOf",
    "inputs",
    "outputs",
    "sources"
  ],
  "properties": {
    "kind": {
      "const": "openspec-assess.manifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "assessmentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "change": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "stage": {
      "enum": [
        "planning",
        "verification"
      ]
    },
    "previousAssessmentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "versionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "asOf": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "profile.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "config.snapshot.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "benchmarks.snapshot.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "profile.json",
        "config.snapshot.json",
        "benchmarks.snapshot.json"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "report.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "report.md": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "report.json",
        "report.md"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "scope": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "type": "object",
          "properties": {
            "defaults": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "overrides": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "effective": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "defaults",
            "overrides",
            "effective"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "artifacts",
        "evidence",
        "scope",
        "config"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "integer",
          "minimum": 1
        },
        "renderer": {
          "type": "integer",
          "minimum": 1
        },
        "normalization": {
          "type": "integer",
          "minimum": 1
        },
        "schemas": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "integer",
              "minimum": 1
            },
            "config": {
              "type": "integer",
              "minimum": 1
            },
            "benchmarks": {
              "type": "integer",
              "minimum": 1
            },
            "manifest": {
              "type": "integer",
              "minimum": 1
            },
            "report": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "profile",
            "config",
            "benchmarks",
            "manifest",
            "report"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "package",
        "evaluator",
        "renderer",
        "normalization",
        "schemas"
      ],
      "additionalProperties": false
    }
  }
}
